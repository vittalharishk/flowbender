# Flowbender Frontend Configuration
# Copy to .env.local and adjust. Never commit .env.local.

# Auth mode: "local" = browser demo mode (localStorage), "api" = real backend auth.
# Production MUST set this to "api" explicitly — there is no automatic switch.
NEXT_PUBLIC_AUTH_MODE=local

# Backend API base URL (used only when NEXT_PUBLIC_AUTH_MODE=api)
NEXT_PUBLIC_API_URL=http://localhost:8000
