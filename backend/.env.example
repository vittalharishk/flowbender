# Flowbender Backend Configuration
# Copy this to .env and adjust values

# Database — SQLite for development (default), PostgreSQL for production
# DATABASE_URL=sqlite+aiosqlite:///./flowbender.db
# DATABASE_URL=postgresql+asyncpg://flowbender:flowbender@localhost:5432/flowbender

# Auth — CHANGE THIS in production
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# Debug mode — set to false in production
DEBUG=true

# Redis (optional — used for rate limiting and caching)
# REDIS_URL=redis://localhost:6379/0

# MinIO / S3 (optional — used for file uploads)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=flowbender
